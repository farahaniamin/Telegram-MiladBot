# Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# or use BOT_TOKEN (legacy)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Database (optional - leave empty for SQLite)
# For PostgreSQL on Render: will be set automatically by Render
DATABASE_URL=
# comma-separated Telegram user IDs (numbers). Example: 123,456
ADMIN_IDS=

# System national code used by watcher (your national code for now)
SYSTEM_NATIONAL_CODE=0310751942

# Default interval in minutes (can be changed by /interval command)
DEFAULT_INTERVAL_MIN=5
# jitter seconds (+/-)
JITTER_SEC=20

# Proxy Settings
# Cloudflare Worker URL for Telegram API (bypass IP ban)
API_URL=https://telegram.farahaniamin6.workers.dev
# Local proxy URL (e.g., http://127.0.0.1:3067)
PROXY_URL=http://127.0.0.1:3067

# Connection Mode (On/Off) - can be toggled by admin commands
# Use local proxy for Telegram connection
USE_LOCAL_PROXY=On
# Use Cloudflare Worker for Telegram API
USE_API_WORKER=On
